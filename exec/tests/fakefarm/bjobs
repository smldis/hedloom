#!/usr/bin/env python3
"""A fake `bjobs`, answering only about jobs that are actually still there.

Three call shapes, because the things that ask are three and a fake that
answers one of them leaves the others untested:

    bjobs -J <name> -noheader          `LSFInteractiveTransport.discover`
    bjobs -noheader -o "job_name stat" `watch.LSFStatusReader.states`
    bjobs <job-id> -noheader           a batch job, addressed the way LSF
                                       addresses one

The second is why the watcher was never exercised against this fake: it was not
implemented, so `states()` read the non-zero exit as "no unfinished job found"
and reported nothing, for every run.

Liveness is derived, never trusted, and *what* it is derived from is the one
place the two submission modes differ here:

* an **interactive** job is live while the `bsub` client that owns it exists,
  which is owner-bound lifetime;
* a **batch** job is live while its own detached supervisor exists, because it
  is deliberately not bound to its client — that is what batch means, and a
  pooled Dask worker is one;
* a finished job is absent either way, as it is from real `bjobs` without `-a`;
* a record with no owning process at all is live, which is how a test plants
  the orphan that `discover` exists to find.
"""

import json
import os
import sys

STATE = os.environ.get("FAKE_LSF_STATE")


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def owner_alive(record):
    """Whichever process this job's mode says holds its lifetime."""

    if record.get("kind") == "batch":
        pid = record.get("supervisor_pid")
    else:
        pid = record.get("owner_pid")
    if pid is None:
        # A leftover from a run this fake did not start. Real LSF cannot tell
        # the difference either; that is the situation discovery is for.
        return True
    return pid_alive(pid)


def live_jobs():
    if not STATE or not os.path.isdir(STATE):
        return []
    jobs = []
    for entry in sorted(os.listdir(STATE)):
        if not entry.endswith(".json"):
            continue
        try:
            with open(os.path.join(STATE, entry)) as handle:
                record = json.load(handle)
        except (OSError, ValueError):
            continue
        if record.get("state") not in ("PEND", "RUN"):
            continue
        if not owner_alive(record):
            continue
        jobs.append(record)
    return jobs


def row(record):
    """One line in the default listing, which callers read whole."""

    user = os.environ.get("USER", "user")
    queue = record.get("options", {}).get("-q", "normal")
    # Interactive records predate ids and are addressed by name; only a batch
    # job has one to report.
    job_id = record.get("id", "9001")
    return f"{job_id} {user} {record['state']} {queue} {record['name']}\n"


def main(argv):
    wanted_name = None
    wanted_id = None
    listing = False
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "-J" and index + 1 < len(argv):
            wanted_name = argv[index + 1]
            index += 2
        elif token == "-o":
            listing = True
            index += 2 if index + 1 < len(argv) else 1
        elif token.startswith("-"):
            index += 1
        else:
            # A bare argument is a job id, which is how LSF addresses a batch
            # job: `LSFCluster` never learns the name it gave, only the id
            # `bsub` printed back.
            wanted_id = token
            index += 1

    if not STATE:
        sys.stderr.write("bjobs: FAKE_LSF_STATE is not set\n")
        return 255

    jobs = live_jobs()

    if listing:
        # `-o "job_name stat"`, one row per job, which is what the reader asks
        # for so that a pending job's missing execution host cannot shift the
        # columns it parses.
        for record in jobs:
            sys.stdout.write(f"{record['name']} {record['state']}\n")
        if not jobs:
            sys.stderr.write("No unfinished job found\n")
            return 255
        return 0

    if wanted_name is None and wanted_id is None:
        sys.stderr.write("bjobs: no job name given\n")
        return 255

    for record in jobs:
        if wanted_name is not None and record["name"] != wanted_name:
            continue
        if wanted_id is not None and str(record.get("id")) != wanted_id:
            continue
        sys.stdout.write(row(record))
        return 0
    sys.stderr.write(f"Job <{wanted_name or wanted_id}> is not found\n")
    return 255


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
