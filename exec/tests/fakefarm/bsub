#!/usr/bin/env python3
"""A fake `bsub` that records the submission and runs the command locally.

It reproduces LSF's command-line shape and exit-status behaviour, not its
scheduling. That is enough to exercise the real subprocess layer — argument
construction, process binding, exit codes, output capture — without a farm.
"""

import json
import os
import subprocess
import sys
import time

STATE = os.environ.get("FAKE_LSF_STATE")


def write_record(path, record):
    """Publish one whole observation so a concurrent `bjobs` never sees half."""

    temporary = f"{path}.{os.getpid()}.tmp"
    with open(temporary, "w") as handle:
        json.dump(record, handle)
    os.replace(temporary, path)


def main(argv):
    interactive = False
    options = {}
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "-I":
            interactive = True
            index += 1
        elif token in ("-J", "-W", "-q", "-n", "-R"):
            options[token] = argv[index + 1]
            index += 2
        elif token.startswith("-"):
            index += 1
        else:
            break

    command = argv[index:]
    if not command:
        sys.stderr.write("bsub: no command supplied\n")
        return 255
    if not interactive:
        # This fake only implements the interactive mode the unit uses.
        sys.stderr.write("bsub: this fake supports -I only\n")
        return 255

    name = options.get("-J", "unnamed")
    record_path = None
    record = {
        "name": name,
        "options": options,
        "command": command,
        "started_at_ns": time.time_ns(),
    }
    if STATE:
        os.makedirs(STATE, exist_ok=True)
        record_path = os.path.join(STATE, f"{name}.json")
        write_record(record_path, record)

    try:
        completed = subprocess.run(command)
    finally:
        if record_path is not None:
            record["ended_at_ns"] = time.time_ns()
            write_record(record_path, record)
    return completed.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
